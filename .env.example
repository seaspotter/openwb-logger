# Copy to .env and adjust. docker-compose reads this automatically.
#
# That's it -- everything about the tool's own behavior (where openWB is,
# which logs to collect, retention, poll interval) is configured from the
# settings panel (gear icon) in the web UI after first start, not here.
# These are pure infra wiring: the database, the web port, and the
# container's clock.

POSTGRES_PASSWORD=change_me
PORT=8080

# Without this the container defaults to UTC, which shows up as an
# apparently-wrong "Letzter Abruf" time in the status bar (that timestamp
# is generated by the app itself -- unlike the log lines' own `ts`, which
# come straight from openWB and are already correct regardless of this).
TZ=Europe/Berlin
