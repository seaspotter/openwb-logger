# Copy to .env and adjust. docker-compose reads this automatically.
#
# That's it -- everything about the tool's own behavior (where openWB is,
# which logs to collect, retention, poll interval) is configured from the
# settings panel (gear icon) in the web UI after first start, not here.
# These two are pure infra wiring for the database and the web port.

POSTGRES_PASSWORD=change_me
PORT=8080
