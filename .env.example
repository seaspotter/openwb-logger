# Copy to .env and adjust. docker-compose reads this automatically.

# --- openWB source ---
# Base URL of the openWB web server (no trailing slash).
OPENWB_BASE_URL=http://10.1.5.32
# Path to the live main log below the base URL.
OPENWB_LOG_PATH=/openWB/ramdisk/main.log
# Number of rotated backups openWB keeps (main.log.1 .. main.log.N), used to
# recover lines lost to a rotation that happened between two polls.
OPENWB_BACKUP_COUNT=4

# --- Polling ---
# How often to fetch the log, in seconds. openWB's main.log fills up (5MB)
# in roughly an hour under normal use; keep this well below that so gaps
# stay recoverable from the .1 backup alone. 600 = 10 min, 900 = 15 min.
FETCH_INTERVAL_SECONDS=600

# --- Retention ---
# Days of log lines to keep. Enforced by a TimescaleDB retention policy.
RETENTION_DAYS=30

# --- Database ---
POSTGRES_PASSWORD=change_me

# --- Web ---
PORT=8080
