# Copy to .env and adjust. docker-compose reads this automatically.
#
# OPENWB_*, FETCH_INTERVAL_SECONDS and RETENTION_DAYS below are only the
# *initial* values, seeded into the database on first boot. After that,
# change them any time from the settings panel in the web UI -- no restart
# needed.

# --- openWB source ---
# Base URL of the openWB web server (no trailing slash).
OPENWB_BASE_URL=http://10.1.5.32
# Ramdisk directory below the base URL that holds the *.log files.
OPENWB_RAMDISK_PATH=/openWB/ramdisk

# --- Polling ---
# How often to fetch, in seconds. openWB's main.log fills up (5MB) in
# roughly an hour under normal use; keep this well below that so gaps
# stay recoverable from its own rotated backup. 600 = 10 min, 900 = 15 min.
FETCH_INTERVAL_SECONDS=600

# --- Retention ---
# Days of log lines to keep. Enforced by a TimescaleDB retention policy.
RETENTION_DAYS=30

# --- Database ---
POSTGRES_PASSWORD=change_me

# --- Web ---
PORT=8080
