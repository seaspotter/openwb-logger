# Copy to .env and adjust. docker-compose reads this automatically.
#
# That's it -- everything about the tool's own behavior (where openWB is,
# which logs to collect, retention, poll interval) is configured from the
# settings panel (gear icon) in the web UI after first start, not here.
# These are pure infra wiring: the database, the web port, and the
# container's clock.

POSTGRES_PASSWORD=change_me
PORT=8080

# Defaults to Europe/Berlin (see docker-compose.yml) without needing to be
# set here at all. Uncomment only if that's not your zone -- otherwise
# "Letzter Abruf" in the status bar (an app-generated timestamp; the log
# lines' own `ts` come straight from openWB and are unaffected either way)
# will be off by however far your zone differs from Berlin.
#TZ=America/New_York
